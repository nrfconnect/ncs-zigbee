#include <matter/nrf54l15dk_cpuapp_partitions_ext_flash.dtsi>

/ {
	chosen {
		zephyr,code-partition = &boot_partition;
		nordic,pm-ext-flash = &mx25r64;
	};
};

&mx25r64 {
	status = "okay";
};

&cpuapp_rram {
	reg = <0x0 DT_SIZE_K(1524)>;
};
