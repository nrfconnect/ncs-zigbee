&flash0 {
	partitions {
		boot_partition: partition@0 {
			compatible = "zephyr,mapped-partition";
			label = "mcuboot";
			reg = <0x0 0xc000>;
		};

		slot0_partition: partition@c000 {
			compatible = "zephyr,mapped-partition";
			label = "image-0";
			reg = <0xc000 0x74000>;
		};

		slot1_partition: partition@80000 {
			compatible = "zephyr,mapped-partition";
			label = "image-1";
			reg = <0x80000 0x74000>;
		};

		zboss_nvram: partition@f5000 {
			compatible = "zephyr,mapped-partition";
			label = "zboss-nvram";
			reg = <0xf5000 0x8000>;
		};

		zboss_product_config: partition@fd000 {
			compatible = "zephyr,mapped-partition";
			label = "zboss-product-config";
			reg = <0xfd000 0x1000>;
		};

		storage_partition: partition@fe000 {
			compatible = "zephyr,mapped-partition";
			label = "storage";
			reg = <0xfe000 0x2000>;
		};
	};
};

