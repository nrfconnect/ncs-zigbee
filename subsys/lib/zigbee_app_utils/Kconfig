menuconfig ZIGBEE_APP_UTILS
	bool "Enable API for Zigbee application utilities"
	help
	  This allows Zigbee applications to call API:

	  - for parsing and converting Zigbee data types
	  - for handling common ZBOSS signals, with behavior depending on the device role
	  - for indicating the device status at the network using onboard LEDs

if ZIGBEE_APP_UTILS

# Configure ZIGBEE_APP_UTILS_LOG_LEVEL
module = ZIGBEE_APP_UTILS
module-str = Zigbee application utilities
source "${ZEPHYR_BASE}/subsys/logging/Kconfig.template.log_config"

menuconfig ZIGBEE_FACTORY_RESET
	bool "Enable API for Zigbee factory reset"
	default y
	imply DK_LIBRARY

if ZIGBEE_FACTORY_RESET

config FACTORY_RESET_PRESS_TIME_SECONDS
	int "Minimal Factory Reset button press time"
	default 5
	help
	  How long a specified button has to be pressed to initiate Factory Reset procedure

endif # ZIGBEE_FACTORY_RESET

config ZIGBEE_APP_IO_SHELL
	bool "Shell commands for simulating buttons and reading LED states"
	depends on SHELL
	depends on DK_LIBRARY
	help
	  Adds the app_io shell command, which simulates button presses
	  of any duration and prints the state of the LEDs.

config ZIGBEE_DEMO_COMMISSIONING
	bool "Allow joining without install codes (insecure, demo only)"
	depends on ZIGBEE_ROLE_COORDINATOR || ZIGBEE_ROLE_ROUTER
	help
	  When the device acts as Trust Center, the default signal handler
	  sets the install code policy to ZB_INSTALL_CODE_NOT_REQUIRED.
	  Devices without an install code can then join using the
	  well-known link key, which any device in radio range can use to
	  obtain the network key.
	  By default, ZBOSS requires install codes on the Trust Center.
	  This option is not the BDB 3.1 backwards compatibility mode: it
	  stays active across all commissioning windows until reboot.
	  Use this option only for demonstrations and testing, never in
	  products.

endif # ZIGBEE_APP_UTILS
